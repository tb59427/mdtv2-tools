# ml-source-bridge configuration
#
# Copy to one of:
#   /etc/ml-source-bridge.toml          (system-wide; preferred for systemd)
#   <install-dir>/config.toml           (alongside the script)
# Or pass --config PATH on the command line.
#
# CLI flags override values set here. Wire-level master/slave (PWR.DET pin)
# is handled automatically by the MCU firmware; nothing in this file
# controls it.


# ---- ML bus role ------------------------------------------------------------
# Which device we pretend to be on the ML bus.
#
#   "sc"  -- SOURCE CENTER (address 0xC2). Provides extra sources to an
#            existing AM/VM. Typical case alongside a B&O music system.
#
#   "am"  -- AUDIO MASTER  (address 0xC1). Pretends to be the audio master
#            for ML link-speakers in setups where no real AM exists.
role = "sc"


# ---- behaviour --------------------------------------------------------------
# Broadcast a CLOCK telegram every 30 minutes. Harmless if the system has
# its own clock authority; useful otherwise.
broadcast_clock = true

# Auto-wake: when a provider's audio stream starts (e.g. AirPlay session
# begins), inject a virtual Beo4 keypress so the AM/VM switches to that
# source automatically.
#
# The wake is SKIPPED when the bus is already on our source -- i.e. you
# picked the source on a remote and the stream only started afterwards.
# Waking there would drag the wake target into a session it was never part
# of (in a multi-room house the VM is the main-room TV, so the main room
# switches itself on mid-listening).
auto_wake = true

# Where the auto-wake telegram is addressed:
#   "vm"   video master (default) -- what a real B&O Source Center does
#   "am"   audio master           -- for AM-only setups, or when you don't
#                                   want the main-room TV coming on
#   "off"  never wake             -- same as auto_wake = false
#   0x06   any ML address         -- e.g. a single link node, so only that
#                                   room comes up. UNVERIFIED: a link node
#                                   is not a master and may ignore it.
wake_target = "vm"


# ---- redis broker -----------------------------------------------------------
redis_host = "localhost"
redis_port = 6379


# ---- sources ----------------------------------------------------------------
# Each [[sources]] entry registers one ML source byte we claim, with the
# audio backend (provider) that produces audio for it. You can register
# multiple sources at once -- e.g. AirPlay on N.MUSIC and MPD on N.RADIO.
#
# Common source bytes:
#   0x6F  RADIO    -- typical for AM-standalone linkspeaker setups
#   0x7A  N.MUSIC  -- network music; standard slot
#   0x8D  CD       -- the system's CD source slot
#   0xA1  N.RADIO  -- network radio; what the legacy ml-netprovide used
#                     and what works in a VM+AM topology with B&O Beosound
#
# Beo4 buttons that trigger each source (auto-wake uses these):
#   RADIO   -> 0x81   N.MUSIC -> 0x94   CD -> 0x92   N.RADIO -> 0x93
#
# Available providers:
#   "airplay"    -- shairport-sync via D-Bus (one shairport instance shared
#                   across all airplay sources)
#   "sendspin"   -- Open Home Foundation multi-room audio via the sendspin
#                   daemon's MPRIS interface (`systemctl status sendspin`).
#                   Same shape as airplay: daemon feeds the DAC, we drive
#                   transport + read metadata over D-Bus.
#   "turntable"  -- a DL'80 Beogram turntable, controlled over the Datalink
#                   wire and looped ADC -> DAC into ML. Configure it in the
#                   [turntable] section below. NOT a default for any source:
#                   set provider = "turntable" on whichever source you want
#                   to give up (N.RADIO 0xA1 is the usual choice).

[[sources]]
source_byte  = 0xA1            # N.RADIO
provider     = "airplay"
display_name = "N.RADIO"        # optional; up to 11 chars ASCII

# Uncomment to also claim N.MUSIC for a second backend:
# [[sources]]
# source_byte  = 0x7A           # N.MUSIC
# provider     = "mpd"
# display_name = "N.MUSIC"

# Turntable on N.RADIO instead of AirPlay -- replace the block above with:
# [[sources]]
# source_byte  = 0xA1           # N.RADIO
# provider     = "turntable"
# display_name = "PHONO"


# ---- turntable provider (DL'80 Beogram as an ML source) --------------------
# Only read when some [[sources]] entry sets provider = "turntable".
#
# What it does: ML transport keys become DL'80 opcodes on the Datalink
# wire (play / stop / next / prev), and the turntable's analogue output is
# looped from the HAT's ADC back out through its DAC onto ML. Selecting the
# source on your Beo remote starts the record; Step Up / Step Down skip
# tracks; leaving the source parks the arm.
#
# On a deck that reports DL'80 status (0xC3 playing / 0xCE stopped),
# pressing PLAY on the turntable itself also wakes the ML system to this
# source (when auto_wake = true). Not all decks do: a Beogram 5500 answers
# only 0xFC/0xF1, which aren't state, so there it follows our commands only
# -- hand-started records don't wake ML, and the source stays selected
# after a side ends until you leave it.

# [turntable]
# ---- audio loopback ----
# loopback        = true                     # false = control only, no audio
# metadata_title  = "PHONO"                  # text shown on the B&O display
#                                            # where a track title would go
#                                            # ("" = leave it blank)
# capture_device  = "hw:sndrpihifiberry,0"   # ADC (turntable in)
# playback_device = "hw:sndrpihifiberry,0"   # DAC (out to ML)
# sample_rate     = 48000
# channels        = 2
# format          = "S32_LE"                 # S32_LE or S16_LE
# period_size     = 0                        # 0 = let ALSA choose; lower =
#                                            # less latency, more xrun risk
#
# ---- ADC front end (PCM1862 over I2C) ----
# IMPORTANT: the ADC comes up on VIN1, but the HAT's phono input is VIN4 --
# leave adc_setup = true or you get a playing record and dead silence.
# Needs i2c-tools and the i2c-dev module (install.sh sets both up).
# adc_setup    = true       # false = don't touch the ADC at all
# pga_db       = 0.0        # analogue gain, -12 .. +40 dB in 0.5 dB steps.
#                           # 0 dB is correct for a LINE-level input -- i.e.
#                           # a turntable with its own RIAA preamp, or a bare
#                           # cartridge through an EXTERNAL phono preamp.
#                           # That is the recommended hookup; keep 0 dB.
#                           # Large values (~+36 dB) only make sense with the
#                           # dev-only software-RIAA path below, and cost you
#                           # noise and headroom.
# i2c_bus      = 1
# i2c_addr     = "0x4a"
# adc_input_reg = 0x48      # 0x48 = VIN4 single-ended (the HAT's phono in)
#
# ---- software RIAA -- DEV / EXPERIMENTAL ONLY, POOR SOUND QUALITY ----
#
#   DO NOT use this to actually listen to records.
#
# It exists to characterise the ADC path and play with curves, nothing more.
# Feeding a ~4 mV cartridge straight into a 3.3 V sigma-delta ADC and then
# making up ~36 dB of gain gives you a thin, noisy signal with no headroom;
# it cannot come close to a real phono stage.
#
# If your turntable has NO built-in RIAA preamp, use an EXTERNAL phono
# preamp into a line input and leave riaa = false / pga_db = 0. If it has
# one built in (most Beograms do), you are already at line level -- also
# leave these off. Either way the correct answer for listening is an
# analogue phono stage, not this.
#
# Uses numpy + scipy, which install.sh provisions for you.
# riaa             = false
# riaa_highpass_hz = 30.0   # subsonic / warp filter; 0 disables
# riaa_gain_db     = 0.0    # fixed makeup gain (a live stream can't be
#                           # peak-normalized the way a finished file is)
#
# ---- local controls on the deck ----
# The deck's own PLAY / STANDBY buttons drive ML, not just the other way
# round: it reports its state on DL'80, so pressing PLAY switches the ML
# system to this source (needs auto_wake = true) and pressing STANDBY
# releases the source and switches ML off.
#
# standby_ml_on_stop = true   # false = release the source but leave ML on
#
# Which status codes mean playing / stopped is deck-dependent. Defaults cover
# the documented codes (0xC3 playing, 0xCE/0xC5/0xC8 stopped) PLUS what a
# Beogram 5500 really emits: 0xFC on start and 0xF1 on stop (established by
# pressing its buttons and watching the wire -- the spec names for those two
# say something else entirely). Override if your deck differs:
# status_playing = [0xC3, 0xFC]
# status_stopped = [0xCE, 0xC5, 0xC8, 0xF1]

# ---- DL'80 opcodes ----
# Defaults are verified on a Beogram 5500 (dl-docs/dl80-beogram/). Override
# per model. Note stop = 0xCB is Sys.Standby, which is BUS-WIDE: other DL'80
# devices on the same wire also go to standby.
# [turntable.opcodes]
# play = 0xA9    # BG.Play
# stop = 0xCB    # Sys.Standby
# next = 0x95    # BG.ADV->
# prev = 0xF3    # BG.<-Ret


# ---- LIGHT-key home-automation hook ----------------------------------------
# Pressing the LIGHT key on a Beo4 remote opens a "light channel": the
# VM/AM then forwards every following keypress to the MLGW address
# (B&O's home-automation gateway) until ~20 s of inactivity, at which
# point the master emits a "Light Timeout" key (0x58) closing the
# channel. We snoop those telegrams and run a configured shell command
# per key.
#
# This is NOT just digits -- ANY Beo4 key works as a binding (Step Up,
# Play, Stop, the colour keys, ...). LIGHT + 1 might be "evening
# scene", LIGHT + Step Up might be "brighten", LIGHT + Stop might be
# "all off". You get to decide.
#
# Disabled by default. Enable + populate `commands` below to use.
# Keys accept any of:
#   - a friendly Beo4 name: "step_up", "play", "red", "digit_1", "1", ...
#   - a hex literal:        "0x1e"
#   - a decimal int:        30
# Common friendly names (full table in core/light_handler.py):
#
#   digits      0..9   (also as "digit_0".."digit_9")
#   transport   play, stop, rewind, wind, return, record, step_up, step_down
#   sound       mute, p_mute, volume_up, volume_down
#   colours     red, green, yellow, blue
#   cursor      cursor_up, cursor_down, cursor_left, cursor_right
#   menu        select, back, exit, menu, info, guide
#   misc        standby, clear, store, reset, goto, format
#
# Commands run as the bridge service user (usually `mdt`), via
# `shell=true` so pipes / env vars / redirects work. A 30 s wall-clock
# timeout is enforced per command. Failures are logged but never
# crash the bridge. Unknown key names are warned about at startup.

# [light_handler]
# enabled   = true
# timeout_s = 20

# [light_handler.commands]
# "digit_1"   = "curl -sX POST http://homeassistant.local:8123/api/services/scene/turn_on -H 'Authorization: Bearer XXXX' -d '{\"entity_id\":\"scene.evening\"}'"
# "digit_2"   = "/usr/local/bin/lights-off.sh"
# "step_up"   = "echo 'brighten' >> /tmp/light.log"
# "step_down" = "echo 'dim'      >> /tmp/light.log"
# "play"      = "echo 'toggle'   >> /tmp/light.log"
# "red"       = "echo 'red scene' >> /tmp/light.log"
