# --- mdt-tools begin ---
# Added by mdt-tools/install.sh. Edit at your own risk; the installer
# leaves these alone if it sees them already present, but it never
# removes them.

# Free /dev/serial0 (PL011) for the MDT MCU UPDI/UART link. Bluetooth
# moves to the mini-UART; we don't use BT in this project anyway.
enable_uart=1
dtoverlay=disable-bt

# Disable the on-board HDMI/3.5mm audio so the DAC+ADC HAT is the only
# soundcard. (HDMI audio also needs ",noaudio" on the vc4-kms-v3d
# overlay -- install.sh patches that elsewhere in this file.)
dtparam=audio=off

# Load the DAC+ADC driver for the on-HAT PCM5122 DAC + PCM1862 ADC
# (the HAT is electrically compatible with the HiFiBerry DAC+ADC, so
# we reuse its kernel overlay; the HAT itself is mdt's own design).
dtoverlay=hifiberry-dacplusadc
# --- mdt-tools end ---
